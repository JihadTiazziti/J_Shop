<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:padding="24dp"
      android:gravity="center_horizontal">

    <ImageView
        android:src="@drawable/login_illustration"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_gravity="center"
        android:layout_marginBottom="16dp" />


    <TextView
        android:text="Hello"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#153B50"
        android:layout_marginTop="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <TextView
        android:text="Sign into your account"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:layout_marginTop="4dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />


    <TextView
        android:text="Email"
        android:textColor="#317A79"
        android:textStyle="bold"
        android:layout_marginTop="24dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <EditText
        android:id="@+id/email"
        android:hint="Enter your email"
        android:inputType="textEmailAddress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />


    <TextView
        android:text="Password"
        android:textColor="#317A79"
        android:textStyle="bold"
        android:layout_marginTop="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <EditText
        android:id="@+id/password"
        android:hint="Enter your password"
        android:inputType="textPassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/forgotPasswordText"
        android:text="Forgot your password?"
        android:textColor="#000000"
        android:textSize="12sp"
        android:layout_gravity="end"
        android:layout_marginTop="6dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />


    <Button
        android:id="@+id/submitButton"
        android:text="Submit"
        android:layout_marginTop="24dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="#D49C8B"
        android:textColor="#FFFFFF" />


    <TextView
        android:text="Or"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginTop="24dp"
        android:layout_gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />


    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center">

      <ImageButton
          android:id="@+id/btnGoogle"
          android:src="@drawable/ic_google"
          android:background="?attr/selectableItemBackgroundBorderless"
          android:contentDescription="Login with Google"
          android:layout_width="60dp"
          android:layout_height="60dp"
          android:scaleType="centerInside"
          android:padding="10dp" />

      <ImageButton
          android:id="@+id/btnFacebook"
          android:src="@drawable/ic_facebook"
          android:background="?attr/selectableItemBackgroundBorderless"
          android:contentDescription="Login with Facebook"
          android:layout_marginStart="24dp"
          android:layout_width="60dp"
          android:layout_height="60dp"
          android:scaleType="centerInside"
          android:padding="10dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvRegister"
        android:text="Don’t have an account? Register Now"
        android:textColor="#0D2B3E"
        android:layout_marginTop="24dp"
        android:layout_gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

  </LinearLayout>
</ScrollView>
