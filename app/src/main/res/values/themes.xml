<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme -->
    <style name="Base.Theme.J_shop" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Tu peux personnaliser ton thème ici -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
    </style>

    <!-- Application Theme -->
    <style name="Theme.J_shop" parent="Base.Theme.J_shop" />

    <!-- Splash screen theme (ne pas imbriquer !) -->
    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primaryColor</item>
        <item name="colorPrimaryVariant">@color/primaryColor</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="android:fontFamily">@font/poppins</item>
    </style>

    <style name="ProductTitleText">
        <item name="android:textColor">@color/textPrimary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/poppins_bold</item>
    </style>
    <style name="Theme.JShop.Splash" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/white</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
    </style>


</resources>
